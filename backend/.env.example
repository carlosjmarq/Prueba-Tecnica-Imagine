# Configuracion del backend. Copiar a .env y ajustar.
APP_NAME=delivery-api
ENVIRONMENT=development
DEBUG=true

# Base de datos (PostgreSQL en Docker)
DATABASE_URL=postgresql+asyncpg://imagine_delivery:imagine_delivery_dev@localhost:5432/imagine_delivery

# JWT
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (siempre S3; en dev apunta a MinIO)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=delivery-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Rate limiting
RATE_LIMIT_PER_MINUTE=60